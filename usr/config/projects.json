  "LocoraProjects": {
    "EnableAutoDiscovery": true,
    "GenerateNginxVHosts": true,
    "GenerateHostsPreview": true,
    "DomainSuffix": "locora.test",
    "DefaultScheme": "http",
    "IndexFileNames": [
