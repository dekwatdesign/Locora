<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5">
            <TextBlock Text="Workbench" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Projects, services, and stack profiles in one operational workspace."
                       TextWrapping="Wrap"
                       Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Search"
                     PlaceholderText="Filter projects, services, profiles"
                     Text="{x:Bind ViewModel.WorkbenchSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource LocoraSecondaryButtonStyle}" />
        </Grid>

        <TabView x:Name="WorkbenchTabs"
                 Grid.Row="2"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="Equal">
            <TabViewItem Header="Projects">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <Border Visibility="{x:Bind ViewModel.ShowFilteredProjectsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource LocoraSectionPanelStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="No matching projects" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="Add a folder under the projects root or clear the search filter." TextWrapping="Wrap" Opacity="0.72" />
                                <StackPanel Spacing="8">
                                    <Button Content="Open Projects Root"
                                            Command="{x:Bind ViewModel.OpenProjectRootCommand}"
                                            Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                    <Button Content="Repair Hosts"
                                            Command="{x:Bind ViewModel.RepairDomainsCommand}"
                                            Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredProjects, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProjectCard">
                                    <Border Style="{StaticResource LocoraSectionPanelStyle}" Margin="0,0,0,10">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Runtime}" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.82" />
                                                <TextBlock Text="{x:Bind TagsLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis" Opacity="0.72" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8" MinWidth="128">
                                                <Button Content="Open Site"
                                                        Command="{x:Bind OpenUrlCommand}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LocoraPrimaryButtonStyle}" />
                                                <Button Content="Folder"
                                                        Command="{x:Bind OpenFolderCommand}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                                <Button Content="Terminal"
                                                        Command="{x:Bind OpenTerminalCommand}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                                <Button Content="{x:Bind PinButtonLabel}"
                                                        Command="{x:Bind TogglePinCommand}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Services">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <StackPanel Spacing="8">
                            <Button Content="Start All"
                                    Command="{x:Bind ViewModel.StartAllCommand}"
                                    Style="{StaticResource LocoraPrimaryButtonStyle}" />
                            <Button Content="Stop All"
                                    Command="{x:Bind ViewModel.StopAllCommand}"
                                    Style="{StaticResource LocoraSecondaryButtonStyle}" />
                            <Button Content="Repair Runtime Configs"
                                    Command="{x:Bind ViewModel.RepairRuntimeCommand}"
                                    Style="{StaticResource LocoraSecondaryButtonStyle}" />
                        </StackPanel>
                        <Border Visibility="{x:Bind ViewModel.ShowFilteredServicesEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource LocoraSectionPanelStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="No matching services" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="Refresh the snapshot or regenerate runtime configuration." TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                        </Border>
                        <ListView ItemsSource="{x:Bind ViewModel.FilteredServices, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ServiceStatusCard">
                                    <Border Style="{StaticResource LocoraSectionPanelStyle}" Margin="0,0,0,10">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind AutoStartLabel}" Opacity="0.72" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind Version}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind Port}" HorizontalAlignment="Right" Opacity="0.72" />
                                                <Border Background="{Binding StateLabel, Converter={StaticResource StatusBrushConverter}}"
                                                        Style="{StaticResource LocoraPillBorderStyle}">
                                                    <TextBlock Text="{x:Bind StateLabel}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" MinWidth="112">
                                                <Button Content="Start"
                                                        Click="OnStartServiceClicked"
                                                        Style="{StaticResource LocoraPrimaryButtonStyle}" />
                                                <Button Content="Stop"
                                                        Click="OnStopServiceClicked"
                                                        Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                                <Button Content="Repair"
                                                        IsEnabled="{x:Bind SupportsRepair, Mode=OneWay}"
                                                        Click="OnRepairServiceClicked"
                                                        Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Stack">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <Border Style="{StaticResource LocoraSectionPanelStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.StackProfileSummaryText, Mode=OneWay}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.StackProfileStatusLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                                <TextBox Header="Save current environment as"
                                         Text="{x:Bind ViewModel.NewStackProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Spacing="8">
                                    <Button Content="Save Active"
                                            Command="{x:Bind ViewModel.SaveActiveEnvironmentCommand}"
                                            Style="{StaticResource LocoraPrimaryButtonStyle}" />
                                    <Button Content="Start Active Stack"
                                            Command="{x:Bind ViewModel.StartAllCommand}"
                                            Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Visibility="{x:Bind ViewModel.ShowFilteredStackProfilesEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource LocoraSectionPanelStyle}">
                            <TextBlock Text="No matching stack profiles" Style="{StaticResource CardTitleTextStyle}" />
                        </Border>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredStackProfiles, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StackProfileCard">
                                    <Border Style="{StaticResource LocoraSectionPanelStyle}" Margin="0,0,0,10">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ServicesLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind PackagesLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8" MinWidth="112">
                                                <Border Background="{Binding State, Converter={StaticResource StatusBrushConverter}}"
                                                        Style="{StaticResource LocoraPillBorderStyle}">
                                                    <TextBlock Text="{x:Bind State}" />
                                                </Border>
                                                <Button Content="{x:Bind SelectButtonLabel}"
                                                        IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                                        Command="{x:Bind SelectProfileCommand}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LocoraSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>

