<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Locora.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowDashboard" />
                <VisualState x:Name="WideDashboard">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FirstRunStepColumn2.Width" Value="*" />
                        <Setter Target="FirstRunStep2.(Grid.Row)" Value="0" />
                        <Setter Target="FirstRunStep2.(Grid.Column)" Value="1" />
                        <Setter Target="FirstRunStep3.(Grid.Row)" Value="1" />
                        <Setter Target="FirstRunStep4.(Grid.Row)" Value="1" />
                        <Setter Target="FirstRunStep4.(Grid.Column)" Value="1" />
                        <Setter Target="FirstRunStep5.(Grid.Row)" Value="2" />
                        <Setter Target="FirstRunStep5.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DashboardMetricColumn2.Width" Value="*" />
                        <Setter Target="DashboardMetricColumn3.Width" Value="*" />
                        <Setter Target="ActiveProfileMetric.(Grid.Row)" Value="0" />
                        <Setter Target="ActiveProfileMetric.(Grid.Column)" Value="1" />
                        <Setter Target="PortableRootMetric.(Grid.Row)" Value="0" />
                        <Setter Target="PortableRootMetric.(Grid.Column)" Value="2" />
                        <Setter Target="DashboardSideColumn.Width" Value="*" />
                        <Setter Target="DashboardSidePanel.(Grid.Row)" Value="0" />
                        <Setter Target="DashboardSidePanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="24" Spacing="24">
            <InfoBar IsOpen="{x:Bind ViewModel.ShowSupervisorWarning, Mode=OneWay}"
                     Severity="Warning"
                     Title="Supervisor not connected"
                     Message="The shell is running, but Locora.Supervisor has not answered yet. You can still review the portable structure and UI." />

            <Border Visibility="{x:Bind ViewModel.ShowFirstRunOnboarding, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="20"
                    CornerRadius="16"
                    AutomationProperties.Name="First-run setup guide"
                    AutomationProperties.HelpText="Guided setup checklist for connecting the supervisor, seeding services, adding projects, enabling SSL, and validating generated config."
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="First-run setup" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.FirstRunProgressLabel, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                AccessKey="H"
                                AutomationProperties.HelpText="Hide the first-run setup guide. You can show it again from Settings."
                                ToolTipService.ToolTip="Hide the setup guide"
                                Command="{x:Bind ViewModel.DismissFirstRunOnboardingCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaCloseGlyph}" Text="Hide" />
                        </Button>
                    </Grid>

                    <TextBlock Text="Use these steps to get from a fresh portable folder to a working local development stack."
                               TextWrapping="Wrap"
                               Opacity="0.82" />

                    <Grid x:Name="FirstRunStepsGrid" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="FirstRunStepColumn2" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="FirstRunStep1"
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="12"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="1. Connect supervisor" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FirstRunSupervisorStepLabel, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                                <Button AccessKey="R"
                                        AutomationProperties.HelpText="Refresh the supervisor snapshot for setup step 1."
                                        ToolTipService.ToolTip="Refresh the supervisor snapshot"
                                        Command="{x:Bind ViewModel.RefreshCommand}"
                                        HorizontalAlignment="Left">
                                    <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FirstRunStep2"
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="12"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="2. Seed services" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FirstRunServicesStepLabel, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                                <Button AccessKey="C"
                                        AutomationProperties.HelpText="Regenerate runtime service configuration for setup step 2."
                                        ToolTipService.ToolTip="Repair runtime service configuration"
                                        Command="{x:Bind ViewModel.RepairRuntimeCommand}"
                                        HorizontalAlignment="Left">
                                    <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair Configs" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FirstRunStep3"
                                Grid.Row="2"
                                Grid.Column="0"
                                Padding="12"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="3. Add projects" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FirstRunProjectsStepLabel, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button AutomationProperties.HelpText="Open the projects root folder for setup step 3."
                                            ToolTipService.ToolTip="Open projects root folder"
                                            Command="{x:Bind ViewModel.OpenProjectRootCommand}">
                                        <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Projects" />
                                    </Button>
                                    <Button AutomationProperties.HelpText="Refresh project discovery for setup step 3."
                                            ToolTipService.ToolTip="Refresh project discovery"
                                            Command="{x:Bind ViewModel.RefreshCommand}">
                                        <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FirstRunStep4"
                                Grid.Row="3"
                                Grid.Column="0"
                                Padding="12"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="4. Enable HTTPS" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FirstRunSslStepLabel, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button AutomationProperties.HelpText="Generate the local certificate authority and project certificates for setup step 4."
                                            ToolTipService.ToolTip="Generate local SSL certificates"
                                            Command="{x:Bind ViewModel.GenerateLocalSslCommand}">
                                        <controls:IconLabel Glyph="{StaticResource FaCertificateGlyph}" Text="Generate SSL" />
                                    </Button>
                                    <Button AutomationProperties.HelpText="Trust the local certificate authority for the current Windows user."
                                            ToolTipService.ToolTip="Trust the local certificate authority"
                                            Command="{x:Bind ViewModel.TrustLocalSslCaCommand}">
                                        <controls:IconLabel Glyph="{StaticResource FaShieldGlyph}" Text="Trust CA" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FirstRunStep5"
                                Grid.Row="4"
                                Grid.ColumnSpan="1"
                                Padding="12"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="5. Validate generated config" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FirstRunValidationStepLabel, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button AutomationProperties.HelpText="Run generated Nginx configuration validation for setup step 5."
                                            ToolTipService.ToolTip="Validate generated Nginx configuration"
                                            Command="{x:Bind ViewModel.ValidateNginxConfigCommand}">
                                        <controls:IconLabel Glyph="{StaticResource FaCheckGlyph}" Text="Validate" />
                                    </Button>
                                    <Button AutomationProperties.HelpText="Regenerate hosts preview, Nginx vhosts, and Apache vhosts."
                                            ToolTipService.ToolTip="Regenerate hosts and vhost artifacts"
                                            Command="{x:Bind ViewModel.RepairDomainsCommand}">
                                        <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" Text="Repair Hosts" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid x:Name="DashboardMetricsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DashboardMetricColumn2" Width="0" />
                    <ColumnDefinition x:Name="DashboardMetricColumn3" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="RunningServicesMetric"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Running Services" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RunningServicesCount, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Border x:Name="ActiveProfileMetric"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Active Profile" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PreferredToolchainSummary, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Border x:Name="PortableRootMetric"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Portable Root" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.EnvironmentRoot, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.LastRefreshLabel, Mode=OneWay}" Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="DashboardContentGrid" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition x:Name="DashboardSideColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="12">
                    <TextBlock Text="Service Overview" Style="{StaticResource SectionTitleTextStyle}" />
                    <Border Visibility="{x:Bind ViewModel.ShowServicesEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="No services reported yet" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="Refresh the supervisor snapshot first. If services are still missing, regenerate the runtime configs from the portable defaults."
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.HelpText="Refresh the supervisor snapshot to reload services."
                                        ToolTipService.ToolTip="Refresh service snapshot"
                                        Command="{x:Bind ViewModel.RefreshCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                </Button>
                                <Button AutomationProperties.HelpText="Regenerate runtime service configuration from bundled defaults."
                                        ToolTipService.ToolTip="Repair runtime service configuration"
                                        Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceStatusCard">
                                <Border Padding="16"
                                        CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        Margin="0,0,0,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Opacity="0.72" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Version}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind Port}" HorizontalAlignment="Right" Opacity="0.72" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Padding="10,4"
                                                CornerRadius="999"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StateLabel}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="DashboardSidePanel" Grid.Row="1" Grid.Column="0" Spacing="12">
                    <TextBlock Text="Attention Needed" Style="{StaticResource SectionTitleTextStyle}" />
                    <Border Visibility="{x:Bind ViewModel.ShowHealthIssuesEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="No health issues in the latest snapshot" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="Keep the snapshot fresh or run config validation before restarting web services."
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.HelpText="Refresh diagnostics and health issues."
                                        ToolTipService.ToolTip="Refresh diagnostics snapshot"
                                        Command="{x:Bind ViewModel.RefreshCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                </Button>
                                <Button AutomationProperties.HelpText="Validate generated Nginx configuration."
                                        ToolTipService.ToolTip="Validate generated Nginx configuration"
                                        Command="{x:Bind ViewModel.ValidateNginxConfigCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaCheckGlyph}" Text="Validate" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HealthIssues, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HealthIssueCard">
                                <Border Padding="16"
                                        CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        Margin="0,0,0,12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind SuggestedAction}" TextWrapping="WrapWholeWords" Opacity="0.72" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Projects" Style="{StaticResource SectionTitleTextStyle}" Margin="0,12,0,0" />
                    <TextBlock Text="Pinned projects stay at the top of this list."
                               Opacity="0.72" />
                    <Border Visibility="{x:Bind ViewModel.ShowProjectsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="No projects discovered yet" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="Open the projects root to add an app, then refresh and regenerate hosts/vhosts when the folder is ready."
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.HelpText="Open the projects root folder in File Explorer."
                                        ToolTipService.ToolTip="Open projects root folder"
                                        Command="{x:Bind ViewModel.OpenProjectRootCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Projects" />
                                </Button>
                                <Button AutomationProperties.HelpText="Refresh project discovery from the supervisor."
                                        ToolTipService.ToolTip="Refresh project discovery"
                                        Command="{x:Bind ViewModel.RefreshCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                </Button>
                                <Button AutomationProperties.HelpText="Regenerate hosts preview, Nginx vhosts, and Apache vhosts."
                                        ToolTipService.ToolTip="Regenerate hosts and vhost artifacts"
                                        Command="{x:Bind ViewModel.RepairDomainsCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" Text="Hosts" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectCard">
                                <Border Padding="16"
                                        CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        Margin="0,0,0,12">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open Site"
                                                            Command="{x:Bind OpenUrlCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{x:Bind OpenUrlAutomationName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolidFontFamily}" Glyph="{StaticResource FaGlobeGlyph}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open Folder"
                                                            Command="{x:Bind OpenFolderCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{x:Bind OpenFolderAutomationName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolidFontFamily}" Glyph="{StaticResource FaFolderOpenGlyph}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Reveal in Explorer"
                                                            Command="{x:Bind RevealInExplorerCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{x:Bind RevealInExplorerAutomationName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolidFontFamily}" Glyph="{StaticResource FaFolderGlyph}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy Folder Path"
                                                            Command="{x:Bind CopyFolderPathCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{x:Bind CopyFolderPathAutomationName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolidFontFamily}" Glyph="{StaticResource FaCopyGlyph}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Terminal"
                                                            Command="{x:Bind OpenTerminalCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{x:Bind OpenTerminalAutomationName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolidFontFamily}" Glyph="{StaticResource FaTerminalGlyph}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Editor"
                                                            Command="{x:Bind OpenEditorCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{x:Bind OpenEditorAutomationName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolidFontFamily}" Glyph="{StaticResource FaEditGlyph}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="{x:Bind PinButtonLabel}"
                                                            Command="{x:Bind TogglePinCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{x:Bind PinAutomationName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolidFontFamily}" Glyph="{StaticResource FaPinGlyph}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                    Command="{x:Bind TogglePinCommand}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{x:Bind PinAutomationName}"
                                                    ToolTipService.ToolTip="{x:Bind PinButtonLabel}">
                                                <controls:IconLabel Glyph="{StaticResource FaPinGlyph}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Url}" />
                                        <TextBlock Text="{x:Bind Runtime}" Opacity="0.72" />
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.82" />
                                        <TextBlock Text="{x:Bind TagsLabel}" Opacity="0.72" />
                                        <TextBlock Text="{x:Bind OverrideSummary}" TextWrapping="Wrap" Opacity="0.72" />
                                        <TextBlock Text="{x:Bind Folder}" TextWrapping="Wrap" Opacity="0.72" />

                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Grid.Row="0"
                                                    Grid.Column="0"
                                                    Command="{x:Bind OpenUrlCommand}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{x:Bind OpenUrlAutomationName}">
                                                <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" Text="Site" />
                                            </Button>
                                            <Button Grid.Row="0"
                                                    Grid.Column="1"
                                                    Command="{x:Bind OpenFolderCommand}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{x:Bind OpenFolderAutomationName}">
                                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Folder" />
                                            </Button>
                                            <Button Grid.Row="1"
                                                    Grid.Column="0"
                                                    Command="{x:Bind OpenTerminalCommand}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{x:Bind OpenTerminalAutomationName}">
                                                <controls:IconLabel Glyph="{StaticResource FaTerminalGlyph}" Text="Term" />
                                            </Button>
                                            <Button Grid.Row="1"
                                                    Grid.Column="1"
                                                    Command="{x:Bind OpenEditorCommand}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{x:Bind OpenEditorAutomationName}">
                                                <controls:IconLabel Glyph="{StaticResource FaEditGlyph}" Text="Editor" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
