<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Locora.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowDiagnostics" />
                <VisualState x:Name="WideDiagnostics">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DiagnosticsSummaryColumn2.Width" Value="*" />
                        <Setter Target="DiagnosticsSummaryColumn3.Width" Value="*" />
                        <Setter Target="DiagnosticsSummaryColumn4.Width" Value="*" />
                        <Setter Target="ConfigChecksSummary.(Grid.Row)" Value="0" />
                        <Setter Target="ConfigChecksSummary.(Grid.Column)" Value="1" />
                        <Setter Target="PortsSummary.(Grid.Row)" Value="0" />
                        <Setter Target="PortsSummary.(Grid.Column)" Value="2" />
                        <Setter Target="PermissionsSummary.(Grid.Row)" Value="0" />
                        <Setter Target="PermissionsSummary.(Grid.Column)" Value="3" />
                        <Setter Target="DiagnosticsDetailColumn2.Width" Value="*" />
                        <Setter Target="DiagnosticsRightColumn.(Grid.Row)" Value="0" />
                        <Setter Target="DiagnosticsRightColumn.(Grid.Column)" Value="1" />
                        <Setter Target="DiagnosticsPrimaryActions.Orientation" Value="Horizontal" />
                        <Setter Target="DiagnosticsSecondaryActions.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="24" Spacing="18">
            <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="One place to understand what is broken, run safe repair actions, and export a support-ready report."
                       TextWrapping="Wrap"
                       Opacity="0.72" />

            <InfoBar IsOpen="{x:Bind ViewModel.ShowSupervisorWarning, Mode=OneWay}"
                     Severity="Warning"
                     Title="Supervisor not connected"
                     Message="Diagnostics are showing the latest offline snapshot until Locora.Supervisor responds again." />

            <Grid x:Name="DiagnosticsSummaryGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DiagnosticsSummaryColumn2" Width="0" />
                    <ColumnDefinition x:Name="DiagnosticsSummaryColumn3" Width="0" />
                    <ColumnDefinition x:Name="DiagnosticsSummaryColumn4" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="OverallStatusSummary"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Overall Status" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DiagnosticsHeadline, Mode=OneWay}"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.DiagnosticsSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Border x:Name="ConfigChecksSummary"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Config Checks" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ConfigValidationSummary, Mode=OneWay}"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Validate generated web server configs before starting or restarting services."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Border x:Name="PortsSummary"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ports" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PortDiagnosticsSummary, Mode=OneWay}"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Detects duplicate service ports and external listeners before startup fails."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Border x:Name="PermissionsSummary"
                        Grid.Row="3"
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Permissions" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PermissionDiagnosticsSummary, Mode=OneWay}"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SupervisorPrivilegeLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Quick Recovery" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="Start with refresh and config validation, then repair generated artifacts or elevate only when protected Windows resources require it."
                               TextWrapping="Wrap"
                               Opacity="0.72" />

                    <StackPanel x:Name="DiagnosticsPrimaryActions" Orientation="Vertical" Spacing="8">
                        <Button AccessKey="R"
                                AutomationProperties.HelpText="Refresh the latest diagnostics snapshot from the supervisor."
                                ToolTipService.ToolTip="Refresh diagnostics snapshot"
                                Command="{x:Bind ViewModel.RefreshCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                        </Button>
                        <Button AccessKey="V"
                                AutomationProperties.HelpText="Validate generated Nginx configuration before service startup."
                                ToolTipService.ToolTip="Validate generated Nginx configuration"
                                Command="{x:Bind ViewModel.ValidateNginxConfigCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaCheckGlyph}" Text="Validate" />
                        </Button>
                        <Button AutomationProperties.HelpText="Regenerate hosts preview, Nginx vhosts, and Apache vhosts."
                                ToolTipService.ToolTip="Regenerate hosts and vhost artifacts"
                                Command="{x:Bind ViewModel.RepairDomainsCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" Text="Hosts" />
                        </Button>
                        <Button AutomationProperties.HelpText="Regenerate common service runtime configuration."
                                ToolTipService.ToolTip="Repair runtime configuration"
                                Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair" />
                        </Button>
                        <Button AutomationProperties.HelpText="Restart the supervisor with administrator rights for protected operations."
                                ToolTipService.ToolTip="Restart supervisor as administrator"
                                Command="{x:Bind ViewModel.RestartSupervisorElevatedCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaAdminGlyph}" Text="Admin" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsSecondaryActions" Orientation="Vertical" Spacing="8">
                        <Button AutomationProperties.HelpText="Generate the Locora local CA and project certificates."
                                ToolTipService.ToolTip="Generate local SSL certificates"
                                Command="{x:Bind ViewModel.GenerateLocalSslCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaCertificateGlyph}" Text="Generate SSL" />
                        </Button>
                        <Button AutomationProperties.HelpText="Repair missing, expired, invalid, or stale local SSL certificates."
                                ToolTipService.ToolTip="Repair local SSL certificates"
                                Command="{x:Bind ViewModel.RepairLocalSslCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaShieldGlyph}" Text="Repair SSL" />
                        </Button>
                        <Button AutomationProperties.HelpText="Trust the Locora local CA for the current Windows user."
                                ToolTipService.ToolTip="Trust local certificate authority"
                                Command="{x:Bind ViewModel.TrustLocalSslCaCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaKeyGlyph}" Text="Trust CA" />
                        </Button>
                        <Button AutomationProperties.HelpText="Copy the diagnostic report to the clipboard."
                                ToolTipService.ToolTip="Copy diagnostic report to clipboard"
                                Command="{x:Bind ViewModel.CopyDiagnosticReportCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaCopyGlyph}" Text="Copy Report" />
                        </Button>
                        <Button AutomationProperties.HelpText="Export the diagnostic report as a Markdown file."
                                ToolTipService.ToolTip="Export diagnostic report as Markdown"
                                Command="{x:Bind ViewModel.ExportDiagnosticReportCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaExportGlyph}" Text="Export" />
                        </Button>
                    </StackPanel>

                    <TextBox Header="Last exported report"
                             Text="{x:Bind ViewModel.DiagnosticReportPath, Mode=OneWay}"
                             IsReadOnly="True" />
                </StackPanel>
            </Border>

            <Grid x:Name="DiagnosticsDetailsGrid" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DiagnosticsDetailColumn2" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="14">
                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Health Issues" Style="{StaticResource SectionTitleTextStyle}" />
                            <Border Visibility="{x:Bind ViewModel.ShowHealthIssuesEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="No health issues reported" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="Refresh when something looks off, or export a report to capture this clean baseline."
                                               TextWrapping="Wrap"
                                               Opacity="0.72" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.HelpText="Refresh health issues from the supervisor."
                                                ToolTipService.ToolTip="Refresh health issues"
                                                Command="{x:Bind ViewModel.RefreshCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                        </Button>
                                        <Button AutomationProperties.HelpText="Export the current clean diagnostics baseline as Markdown."
                                                ToolTipService.ToolTip="Export diagnostic report"
                                                Command="{x:Bind ViewModel.ExportDiagnosticReportCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaExportGlyph}" Text="Export" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.HealthIssues, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HealthIssueCard">
                                        <Border Padding="12"
                                                Margin="0,0,0,8"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind Severity}" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind SuggestedAction}" TextWrapping="Wrap" Opacity="0.72" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Config Validation" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ConfigValidationSummary, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <Border Visibility="{x:Bind ViewModel.ShowValidationResultsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="No validation results yet" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="Run validation before restarting Nginx so broken generated config is caught early."
                                               TextWrapping="Wrap"
                                               Opacity="0.72" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.HelpText="Validate generated Nginx configuration."
                                                ToolTipService.ToolTip="Validate generated Nginx configuration"
                                                Command="{x:Bind ViewModel.ValidateNginxConfigCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaCheckGlyph}" Text="Validate" />
                                        </Button>
                                        <Button AutomationProperties.HelpText="Regenerate common service runtime configuration."
                                                ToolTipService.ToolTip="Repair runtime configuration"
                                                Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ValidationResults, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ValidationResultCard">
                                        <Border Padding="12"
                                                Margin="0,0,0,8"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind State}" />
                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind CheckedAt}" Opacity="0.72" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DiagnosticsRightColumn" Grid.Row="1" Grid.Column="0" Spacing="14">
                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Port Diagnostics" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PortDiagnosticsSummary, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <Border Visibility="{x:Bind ViewModel.ShowPortDiagnosticsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="No port diagnostics available" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="Refresh the snapshot or regenerate runtime configs so Locora can inspect expected service ports again."
                                               TextWrapping="Wrap"
                                               Opacity="0.72" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.HelpText="Refresh port diagnostics from the supervisor."
                                                ToolTipService.ToolTip="Refresh port diagnostics"
                                                Command="{x:Bind ViewModel.RefreshCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                        </Button>
                                        <Button AutomationProperties.HelpText="Regenerate common service runtime configuration."
                                                ToolTipService.ToolTip="Repair runtime configuration"
                                                Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PortDiagnostics, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PortDiagnosticCard">
                                        <Border Padding="12"
                                                Margin="0,0,0,8"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind StateLabel}" />
                                                <TextBlock Text="{x:Bind PortLabel}" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind OwnerLabel}" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind SuggestedAction}" TextWrapping="Wrap" Opacity="0.72" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Permission Diagnostics" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PermissionDiagnosticsSummary, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <Border Visibility="{x:Bind ViewModel.ShowPermissionDiagnosticsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="No permission diagnostics available" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="Refresh to ask the supervisor for permission checks, or restart elevated when protected Windows resources need writes."
                                               TextWrapping="Wrap"
                                               Opacity="0.72" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.HelpText="Refresh permission diagnostics from the supervisor."
                                                ToolTipService.ToolTip="Refresh permission diagnostics"
                                                Command="{x:Bind ViewModel.RefreshCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                        </Button>
                                        <Button AutomationProperties.HelpText="Restart the supervisor with administrator rights."
                                                ToolTipService.ToolTip="Restart supervisor as administrator"
                                                Command="{x:Bind ViewModel.RestartSupervisorElevatedCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaAdminGlyph}" Text="Admin" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PermissionDiagnostics, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PermissionDiagnosticCard">
                                        <Border Padding="12"
                                                Margin="0,0,0,8"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind StateLabel}" />
                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind SuggestedAction}" TextWrapping="Wrap" Opacity="0.72" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Local SSL" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SslSummary, Mode=OneWay}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SslDetails, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBlock Text="{x:Bind ViewModel.SslTrustLabel, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SslTrustAccessDiagnosticLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBlock Text="{x:Bind ViewModel.SslProjectCertificateLabel, Mode=OneWay}" Opacity="0.72" />
                            <TextBlock Text="{x:Bind ViewModel.SslLastGeneratedLabel, Mode=OneWay}" Opacity="0.72" />
                            <TextBlock Text="{x:Bind ViewModel.SslCaExpirationLabel, Mode=OneWay}" Opacity="0.72" />
                            <TextBlock Text="{x:Bind ViewModel.SslRepairLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />

                            <Border Visibility="{x:Bind ViewModel.ShowSslCertificateDiagnosticsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="No SSL certificate diagnostics yet" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="Generate local SSL to create project certificates, or run repair to renew missing and expired certs."
                                               TextWrapping="Wrap"
                                               Opacity="0.72" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.HelpText="Generate the Locora local CA and project certificates."
                                                ToolTipService.ToolTip="Generate local SSL certificates"
                                                Command="{x:Bind ViewModel.GenerateLocalSslCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaCertificateGlyph}" Text="Generate SSL" />
                                        </Button>
                                        <Button AutomationProperties.HelpText="Repair missing, expired, invalid, or stale local SSL certificates."
                                                ToolTipService.ToolTip="Repair local SSL certificates"
                                                Command="{x:Bind ViewModel.RepairLocalSslCommand}">
                                            <controls:IconLabel Glyph="{StaticResource FaShieldGlyph}" Text="Repair SSL" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SslCertificateDiagnostics, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SslCertificateDiagnosticCard">
                                        <Border Padding="12"
                                                Margin="0,0,0,8"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind ProjectName}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{x:Bind Host}" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind StateLabel}" />
                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind ExpiresAtLabel}" Opacity="0.72" />
                                                <TextBlock Text="{x:Bind SuggestedAction}" TextWrapping="Wrap" Opacity="0.72" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
