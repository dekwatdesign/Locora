<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Locora.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Activity" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.LogsRoot, Mode=OneWay}" Opacity="0.72" />

            <Border Visibility="{x:Bind ViewModel.ShowActivityEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="No activity has been recorded yet" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Refresh the environment snapshot or open the logs folder if you want to inspect raw supervisor output."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AccessKey="R"
                                AutomationProperties.HelpText="Refresh recent activity from the supervisor snapshot."
                                ToolTipService.ToolTip="Refresh activity"
                                Command="{x:Bind ViewModel.RefreshCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                        </Button>
                        <Button AccessKey="L"
                                AutomationProperties.HelpText="Open the logs folder in File Explorer."
                                ToolTipService.ToolTip="Open logs folder"
                                Command="{x:Bind ViewModel.OpenLogsRootCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Logs" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TimelineEntry">
                        <Border Padding="16"
                                Margin="0,0,0,12"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Timestamp}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Level}" Opacity="0.72" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
