<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Activity" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.LogsRoot, Mode=OneWay}" Opacity="0.72" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TimelineEntry">
                        <Border Padding="16"
                                Margin="0,0,0,12"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Timestamp}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Level}" Opacity="0.72" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
