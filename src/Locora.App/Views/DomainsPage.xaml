<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.DomainsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Locora.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Domains &amp; Hosts" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Locora generates a hosts preview from discovered projects first. Applying writes only a managed Locora block and creates a rollback backup."
                       TextWrapping="Wrap" />

            <InfoBar IsOpen="True"
                     Severity="Warning"
                     Title="Requires administrator rights"
                     Message="The Windows hosts file is protected. If Apply fails, restart Locora.Supervisor as administrator or use LOCORA_HOSTS_FILE to test against a safe file." />

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Supervisor Privileges" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SupervisorPrivilegeLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.SupervisorProcessLabel, Mode=OneWay}" Opacity="0.72" />
                    <TextBlock Text="{x:Bind ViewModel.HostsAccessDiagnosticLabel, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ElevationRestartDiagnosticLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                    <TextBlock Text="{x:Bind ViewModel.WorkspaceWriteAccessDiagnosticLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Generated Domain Defaults" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Choose the suffix and default scheme for generated project URLs. HTTPS defaults work best after Local SSL has been generated and trusted."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <TextBox Header="Domain suffix"
                             AutomationProperties.HelpText="Domain suffix used for generated project hostnames."
                             Text="{x:Bind ViewModel.GeneratedDomainSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="test or dev.local" />
                    <ComboBox Header="Default scheme"
                              AutomationProperties.HelpText="Default URL scheme for generated project URLs."
                              ItemsSource="{x:Bind ViewModel.DomainSchemes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.GeneratedDomainScheme, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.DomainSettingsPreview, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.DomainSettingsStatus, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <TextBox Header="Project domain settings file"
                             Text="{x:Bind ViewModel.ProjectsSettingsFilePath, Mode=OneWay}"
                             IsReadOnly="True" />
                    <Button AccessKey="S"
                            AutomationProperties.HelpText="Save generated domain suffix and default scheme to projects.json."
                            ToolTipService.ToolTip="Save generated domain defaults"
                            Command="{x:Bind ViewModel.SaveDomainSettingsCommand}"
                            HorizontalAlignment="Left">
                        <controls:IconLabel Glyph="{StaticResource FaSaveGlyph}" Text="Save Defaults" />
                    </Button>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Generated Preview" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBox Header="Generated hosts preview file"
                             Text="{x:Bind ViewModel.HostsPreviewPath, Mode=OneWay}"
                             IsReadOnly="True" />

                    <TextBlock Text="Windows Hosts File" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBox Header="Windows hosts target"
                             Text="{x:Bind ViewModel.WindowsHostsFilePath, Mode=OneWay}"
                             IsReadOnly="True" />

                    <TextBlock Text="Rollback Backups" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBox Header="Hosts rollback backups folder"
                             Text="{x:Bind ViewModel.HostsBackupRoot, Mode=OneWay}"
                             IsReadOnly="True" />

                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.HelpText="Regenerate hosts preview, Nginx vhosts, and Apache vhosts."
                                    ToolTipService.ToolTip="Regenerate hosts and vhost artifacts"
                                    Command="{x:Bind ViewModel.RepairDomainsCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" Text="Repair Hosts" />
                            </Button>
                            <Button AutomationProperties.HelpText="Regenerate common service runtime configuration."
                                    ToolTipService.ToolTip="Repair runtime configuration"
                                    Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair Configs" />
                            </Button>
                            <Button AutomationProperties.HelpText="Restart the supervisor with administrator rights for protected hosts operations."
                                    ToolTipService.ToolTip="Restart supervisor as administrator"
                                    Command="{x:Bind ViewModel.RestartSupervisorElevatedCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaAdminGlyph}" Text="Admin" />
                            </Button>
                            <Button AutomationProperties.HelpText="Validate generated Nginx configuration before starting or restarting services."
                                    ToolTipService.ToolTip="Validate generated Nginx configuration"
                                    Command="{x:Bind ViewModel.ValidateNginxConfigCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaCheckGlyph}" Text="Validate" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.HelpText="Generate the Locora local CA and project certificates."
                                    ToolTipService.ToolTip="Generate local SSL certificates"
                                    Command="{x:Bind ViewModel.GenerateLocalSslCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaCertificateGlyph}" Text="Generate SSL" />
                            </Button>
                            <Button AutomationProperties.HelpText="Repair missing, expired, invalid, or stale local SSL certificates."
                                    ToolTipService.ToolTip="Repair local SSL certificates"
                                    Command="{x:Bind ViewModel.RepairLocalSslCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaShieldGlyph}" Text="Repair SSL" />
                            </Button>
                            <Button AutomationProperties.HelpText="Trust the Locora local CA for the current Windows user."
                                    ToolTipService.ToolTip="Trust local certificate authority"
                                    Command="{x:Bind ViewModel.TrustLocalSslCaCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaKeyGlyph}" Text="Trust CA" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.HelpText="Remove current-user trust for the Locora local CA."
                                    ToolTipService.ToolTip="Remove local CA trust"
                                    Command="{x:Bind ViewModel.RollbackLocalSslTrustCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaTrashGlyph}" Text="Untrust CA" />
                            </Button>
                            <Button AutomationProperties.HelpText="Apply the generated hosts preview as the managed Locora block."
                                    ToolTipService.ToolTip="Apply generated hosts preview"
                                    Command="{x:Bind ViewModel.ApplyHostsPreviewCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaUploadGlyph}" Text="Apply" />
                            </Button>
                            <Button AutomationProperties.HelpText="Restore the latest hosts-file rollback backup."
                                    ToolTipService.ToolTip="Rollback latest hosts-file backup"
                                    Command="{x:Bind ViewModel.RollbackHostsCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaBackupGlyph}" Text="Rollback" />
                            </Button>
                            <Button AutomationProperties.HelpText="Refresh the latest supervisor snapshot."
                                    ToolTipService.ToolTip="Refresh domains snapshot"
                                    Command="{x:Bind ViewModel.RefreshCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local Tunnels" Style="{StaticResource CardTitleTextStyle}" />
                    <InfoBar IsOpen="True"
                             Severity="Warning"
                             Title="External access"
                             Message="Starting a tunnel may expose the selected local project until the terminal session is stopped." />
                    <InfoBar IsOpen="{x:Bind ViewModel.ShowExternalAccessConsentWarning, Mode=OneWay}"
                             Severity="Error"
                             Title="Consent required"
                             Message="Tunnel commands are blocked until external access consent is confirmed for this app session." />
                    <ToggleSwitch Header="I understand this can expose the selected local project to anyone with the generated public URL."
                                  OffContent="Not confirmed"
                                  OnContent="Confirmed"
                                  IsOn="{x:Bind ViewModel.ExternalAccessConsentAccepted, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ExternalAccessConsentStatus, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <TextBlock Text="Firewall &amp; Network Guidance" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.NetworkGuidanceSummary, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <Border Visibility="{x:Bind ViewModel.ShowNetworkGuidanceEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <TextBlock Text="Network guidance is not available yet" Style="{StaticResource CardTitleTextStyle}" />
                    </Border>
                    <ItemsControl Visibility="{x:Bind ViewModel.HasNetworkGuidance, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ItemsSource="{x:Bind ViewModel.NetworkGuidance, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NetworkGuidanceCard">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Margin="0,0,0,8"
                                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind ScopeLabel}" Opacity="0.72" />
                                        <TextBlock Text="{x:Bind PortLabel}" />
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                        <TextBlock Text="{x:Bind SuggestedAction}" TextWrapping="Wrap" Opacity="0.82" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Share URL Lifecycle" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ShareUrlLifecycleSummary, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <Button AutomationProperties.HelpText="Remove stopped share URL sessions from this list."
                            ToolTipService.ToolTip="Clear stopped share URLs"
                            Command="{x:Bind ViewModel.ClearStoppedShareUrlsCommand}"
                            HorizontalAlignment="Left">
                        <controls:IconLabel Glyph="{StaticResource FaTrashGlyph}" Text="Clear Stopped" />
                    </Button>
                    <Border Visibility="{x:Bind ViewModel.ShowShareUrlSessionsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <TextBlock Text="No share URLs are being tracked" Style="{StaticResource CardTitleTextStyle}" />
                    </Border>
                    <ItemsControl Visibility="{x:Bind ViewModel.HasShareUrlSessions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ItemsSource="{x:Bind ViewModel.ShareUrlSessions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ShareUrlSessionCard">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Margin="0,0,0,8"
                                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ProfileName}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{x:Bind PublicUrlLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Details, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind ProviderLabel}" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind TargetLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind ProjectLabel}" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind LastUpdatedAtLabel, Mode=OneWay}" Opacity="0.72" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <Button Style="{StaticResource CompactIconButtonStyle}"
                                                    AutomationProperties.Name="{x:Bind CopyAutomationName}"
                                                    AutomationProperties.HelpText="Copy this public share URL to the clipboard."
                                                    ToolTipService.ToolTip="Copy share URL"
                                                    IsEnabled="{x:Bind CanCopy, Mode=OneWay}"
                                                    Command="{x:Bind CopyCommand}"
                                                    CommandParameter="{x:Bind}">
                                                <controls:IconLabel Glyph="{StaticResource FaCopyGlyph}" />
                                            </Button>
                                            <Button Style="{StaticResource CompactIconButtonStyle}"
                                                    AutomationProperties.Name="{x:Bind OpenAutomationName}"
                                                    AutomationProperties.HelpText="Open this public share URL in the browser."
                                                    ToolTipService.ToolTip="Open share URL"
                                                    IsEnabled="{x:Bind CanOpen, Mode=OneWay}"
                                                    Command="{x:Bind OpenCommand}"
                                                    CommandParameter="{x:Bind}">
                                                <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" />
                                            </Button>
                                            <Button Style="{StaticResource CompactIconButtonStyle}"
                                                    AutomationProperties.Name="{x:Bind StopAutomationName}"
                                                    AutomationProperties.HelpText="Stop the terminal session backing this share URL."
                                                    ToolTipService.ToolTip="Stop sharing"
                                                    IsEnabled="{x:Bind CanStop, Mode=OneWay}"
                                                    Command="{x:Bind StopCommand}"
                                                    CommandParameter="{x:Bind}">
                                                <controls:IconLabel Glyph="{StaticResource FaStopGlyph}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Tunnel Profiles" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LocalTunnelsStatus, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <TextBox Header="Local tunnel profiles"
                             Text="{x:Bind ViewModel.LocalTunnelsSettingsFilePath, Mode=OneWay}"
                             IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.HelpText="Reload local tunnel profiles from local-tunnels.json."
                                ToolTipService.ToolTip="Reload local tunnel profiles"
                                Command="{x:Bind ViewModel.ReloadLocalTunnelsCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Reload" />
                        </Button>
                        <Button AutomationProperties.HelpText="Open the local tunnel profiles JSON file."
                                ToolTipService.ToolTip="Open local-tunnels.json"
                                Command="{x:Bind ViewModel.OpenLocalTunnelsSettingsFileCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Config" />
                        </Button>
                    </StackPanel>

                    <Border Visibility="{x:Bind ViewModel.ShowLocalTunnelsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="No local tunnel profiles configured" Style="{StaticResource CardTitleTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.HelpText="Open the local tunnel profiles JSON file."
                                        ToolTipService.ToolTip="Open local-tunnels.json"
                                        Command="{x:Bind ViewModel.OpenLocalTunnelsSettingsFileCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Config" />
                                </Button>
                                <Button AutomationProperties.HelpText="Reload local tunnel profiles from local-tunnels.json."
                                        ToolTipService.ToolTip="Reload local tunnel profiles"
                                        Command="{x:Bind ViewModel.ReloadLocalTunnelsCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Reload" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl Visibility="{x:Bind ViewModel.HasLocalTunnels, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ItemsSource="{x:Bind ViewModel.LocalTunnels, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LocalTunnelProfileCard">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Margin="0,0,0,8"
                                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind ProviderLabel}" />
                                            <TextBlock Text="{x:Bind ScopeLabel}" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind TargetLabel}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind CommandLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind TagsLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                AutomationProperties.Name="{x:Bind StartAutomationName}"
                                                AutomationProperties.HelpText="Start this local tunnel profile in the built-in terminal."
                                                ToolTipService.ToolTip="Start local tunnel"
                                                Command="{x:Bind StartCommand}"
                                                CommandParameter="{x:Bind}"
                                                VerticalAlignment="Center">
                                            <controls:IconLabel Glyph="{StaticResource FaShareGlyph}" Text="Start" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Project Domain Mappings" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Override a generated hostname and add dashboard metadata with a .locora.json file in the project root, for example &#123; &quot;domain&quot;: &quot;my-app.test&quot;, &quot;description&quot;: &quot;Customer portal&quot;, &quot;tags&quot;: [ &quot;php&quot;, &quot;api&quot; ] &#125;. Locora skips hosts and vhost generation when multiple projects claim the same hostname."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <Border Visibility="{x:Bind ViewModel.ShowProjectsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="No project mappings to generate yet" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="Add a project folder or .locora.json override in the projects root, refresh discovery, then repair hosts and vhosts."
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.HelpText="Open the projects root folder in File Explorer."
                                        ToolTipService.ToolTip="Open projects root folder"
                                        Command="{x:Bind ViewModel.OpenProjectRootCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Projects" />
                                </Button>
                                <Button AutomationProperties.HelpText="Refresh project discovery from the supervisor."
                                        ToolTipService.ToolTip="Refresh project discovery"
                                        Command="{x:Bind ViewModel.RefreshCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                                </Button>
                                <Button AutomationProperties.HelpText="Regenerate hosts preview, Nginx vhosts, and Apache vhosts."
                                        ToolTipService.ToolTip="Regenerate hosts and vhost artifacts"
                                        Command="{x:Bind ViewModel.RepairDomainsCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" Text="Hosts" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectCard">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="{x:Bind Url}" />
                                    <TextBlock Text="{x:Bind Runtime}" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.82" />
                                    <TextBlock Text="{x:Bind TagsLabel}" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind OverrideSummary}" TextWrapping="Wrap" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind Folder}" TextWrapping="Wrap" Opacity="0.72" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local SSL" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SslSummary, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.SslDetails, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                    <TextBlock Text="{x:Bind ViewModel.SslTrustLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.SslTrustAccessDiagnosticLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                    <TextBlock Text="{x:Bind ViewModel.SslProjectCertificateLabel, Mode=OneWay}" Opacity="0.72" />
                    <TextBlock Text="{x:Bind ViewModel.SslLastGeneratedLabel, Mode=OneWay}" Opacity="0.72" />
                    <TextBlock Text="{x:Bind ViewModel.SslCaExpirationLabel, Mode=OneWay}" Opacity="0.72" />
                    <TextBlock Text="{x:Bind ViewModel.SslRepairLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />

                    <TextBlock Text="CA Certificate" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBox Header="CA certificate path"
                             Text="{x:Bind ViewModel.SslAuthorityPath, Mode=OneWay}"
                             IsReadOnly="True" />

                    <TextBlock Text="Project Certificates" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBox Header="Project certificates folder"
                             Text="{x:Bind ViewModel.SslCertificatesRoot, Mode=OneWay}"
                             IsReadOnly="True" />
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Config Validation" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Run this before restarting Nginx. Locora also blocks Nginx startup when validation fails."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <Border Visibility="{x:Bind ViewModel.ShowValidationResultsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="No config validation has run yet" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="Validate generated configs now, or repair runtime configs first if the generated files are missing."
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.HelpText="Validate generated Nginx configuration before service startup."
                                        ToolTipService.ToolTip="Validate generated Nginx configuration"
                                        Command="{x:Bind ViewModel.ValidateNginxConfigCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaCheckGlyph}" Text="Validate" />
                                </Button>
                                <Button AutomationProperties.HelpText="Regenerate common service runtime configuration."
                                        ToolTipService.ToolTip="Repair runtime configuration"
                                        Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                                    <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ValidationResults, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ValidationResultCard">
                                <StackPanel Spacing="6" Margin="0,0,0,12">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="{x:Bind State}" />
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind CheckedAt}" Opacity="0.72" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
