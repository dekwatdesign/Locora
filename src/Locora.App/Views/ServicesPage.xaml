<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Locora.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowServices" />
                <VisualState x:Name="WideServices">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ServicesHeaderActions.Orientation" Value="Horizontal" />
                        <Setter Target="MailpitDetailsColumn.Width" Value="*" />
                        <Setter Target="MailpitConnectionPanel.(Grid.Row)" Value="0" />
                        <Setter Target="MailpitConnectionPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Services" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Manage configured services one by one. The supervisor starts processes from usr/config/services.json, streams logs, and reports executable/port health."
                       TextWrapping="Wrap" />
            <StackPanel x:Name="ServicesHeaderActions" Orientation="Vertical" Spacing="8">
                <Button AccessKey="R"
                        AutomationProperties.HelpText="Regenerate service runtime configuration from bundled defaults."
                        ToolTipService.ToolTip="Repair service runtime configuration"
                        Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                    <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair Configs" />
                </Button>
                <Button AccessKey="F"
                        AutomationProperties.HelpText="Refresh services and diagnostics from the supervisor."
                        ToolTipService.ToolTip="Refresh service snapshot"
                        Command="{x:Bind ViewModel.RefreshCommand}">
                    <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                </Button>
            </StackPanel>

            <Border Visibility="{x:Bind ViewModel.HasServicePresets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Service Presets" Style="{StaticResource CardTitleTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ServicePresets, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ServicePresetCard">
                                <Border Padding="12"
                                        Margin="0,0,0,8"
                                        CornerRadius="8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind ServicesLabel}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind TagsLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Padding="10,4"
                                                    CornerRadius="999"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind State}" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button AutomationProperties.Name="{x:Bind StartAutomationName}"
                                                        AutomationProperties.HelpText="Start every service in this preset."
                                                        ToolTipService.ToolTip="Start service preset"
                                                        IsEnabled="{x:Bind CanRun, Mode=OneWay}"
                                                        Click="OnStartServicePresetClicked">
                                                    <controls:IconLabel Glyph="{StaticResource FaPlayGlyph}" Text="Start" />
                                                </Button>
                                                <Button AutomationProperties.Name="{x:Bind StopAutomationName}"
                                                        AutomationProperties.HelpText="Stop every service in this preset in reverse order."
                                                        ToolTipService.ToolTip="Stop service preset"
                                                        IsEnabled="{x:Bind CanRun, Mode=OneWay}"
                                                        Click="OnStopServicePresetClicked">
                                                    <controls:IconLabel Glyph="{StaticResource FaStopGlyph}" Text="Stop" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Visibility="{x:Bind ViewModel.ShowMailpitIntegration, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Mail Testing" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MailpitHeadline, Mode=OneWay}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.MailpitSummary, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="MailpitDetailsColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.MailpitServiceStateLabel, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.MailpitSmtpLabel, Mode=OneWay}" Opacity="0.72" />
                            <TextBlock Text="{x:Bind ViewModel.MailpitInboxUrl, Mode=OneWay}" Opacity="0.72" />
                        </StackPanel>

                        <StackPanel x:Name="MailpitConnectionPanel" Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Connection details" />
                            <TextBlock Text="{x:Bind ViewModel.MailpitConnectionDetailsLabel, Mode=OneWay}" Opacity="0.72" />
                            <TextBlock Text="{x:Bind ViewModel.MailpitConnectionDetailsPath, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.HelpText="Open the Mailpit inbox in the default browser."
                                ToolTipService.ToolTip="Open Mailpit inbox"
                                Command="{x:Bind ViewModel.OpenMailpitInboxCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaInboxGlyph}" Text="Inbox" />
                        </Button>
                        <Button AutomationProperties.HelpText="Copy Mailpit SMTP connection settings to the clipboard."
                                ToolTipService.ToolTip="Copy Mailpit SMTP settings"
                                Command="{x:Bind ViewModel.CopyMailpitSmtpConfigCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaCopyGlyph}" Text="SMTP" />
                        </Button>
                        <Button AutomationProperties.HelpText="Open the generated Mailpit connection details file."
                                ToolTipService.ToolTip="Open Mailpit connection details"
                                Command="{x:Bind ViewModel.OpenMailpitConnectionDetailsCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Details" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Visibility="{x:Bind ViewModel.ShowServicesEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="No services are available yet" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Refresh the supervisor snapshot. If nothing appears, repair runtime configs so Locora can rewrite service definitions from the bundled defaults."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.HelpText="Refresh services from the supervisor."
                                ToolTipService.ToolTip="Refresh service snapshot"
                                Command="{x:Bind ViewModel.RefreshCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                        </Button>
                        <Button AutomationProperties.HelpText="Regenerate service runtime configuration from bundled defaults."
                                ToolTipService.ToolTip="Repair service runtime configuration"
                                Command="{x:Bind ViewModel.RepairRuntimeCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair" />
                        </Button>
                        <Button AutomationProperties.HelpText="Open the portable root folder in File Explorer."
                                ToolTipService.ToolTip="Open portable root folder"
                                Command="{x:Bind ViewModel.OpenEnvironmentRootCommand}">
                            <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Root" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListView ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServiceStatusCard">
                        <Border Padding="16"
                                CornerRadius="12"
                                Margin="0,0,0,12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Opacity="0.72" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind Version}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind Port}" HorizontalAlignment="Right" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind AutoStartLabel}" HorizontalAlignment="Right" Opacity="0.72" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StateLabel}" />
                                </Border>

                                <StackPanel Grid.Column="3"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <StackPanel Visibility="{x:Bind IsMailpitService, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button Style="{StaticResource CompactIconButtonStyle}"
                                                AutomationProperties.Name="{x:Bind OpenMailpitInboxAutomationName}"
                                                AutomationProperties.HelpText="Open the Mailpit inbox in the default browser."
                                                ToolTipService.ToolTip="Open Mailpit inbox"
                                                Click="OnOpenMailpitInboxClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaInboxGlyph}" />
                                        </Button>
                                        <Button Style="{StaticResource CompactIconButtonStyle}"
                                                AutomationProperties.Name="{x:Bind CopyMailpitSmtpAutomationName}"
                                                AutomationProperties.HelpText="Copy Mailpit SMTP settings to the clipboard."
                                                ToolTipService.ToolTip="Copy Mailpit SMTP settings"
                                                Click="OnCopyMailpitSmtpClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaCopyGlyph}" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Visibility="{x:Bind SupportsDatabaseAdminTool, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button Style="{StaticResource CompactIconButtonStyle}"
                                                AutomationProperties.Name="{x:Bind OpenDatabaseAdminAutomationName}"
                                                AutomationProperties.HelpText="Launch a detected desktop database admin tool for this service."
                                                ToolTipService.ToolTip="Open database admin tool"
                                                Click="OnOpenDatabaseAdminClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaDatabaseGlyph}" />
                                        </Button>
                                        <Button Style="{StaticResource CompactIconButtonStyle}"
                                                AutomationProperties.Name="{x:Bind CopyDatabaseConnectionAutomationName}"
                                                AutomationProperties.HelpText="Copy database host, port, URL, and credential hints to the clipboard."
                                                ToolTipService.ToolTip="Copy database connection settings"
                                                Click="OnCopyDatabaseConnectionClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaCopyGlyph}" />
                                        </Button>
                                        <Button Style="{StaticResource CompactIconButtonStyle}"
                                                AutomationProperties.Name="{x:Bind OpenDatabaseDetailsAutomationName}"
                                                AutomationProperties.HelpText="Open the generated database connection details file or config folder."
                                                ToolTipService.ToolTip="Open database connection details"
                                                Click="OnOpenDatabaseDetailsClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button AutomationProperties.Name="{x:Bind RepairAutomationName}"
                                                AutomationProperties.HelpText="Regenerate service-specific configuration and refresh diagnostics."
                                                ToolTipService.ToolTip="Repair this service configuration"
                                                IsEnabled="{x:Bind SupportsRepair, Mode=OneWay}"
                                                Click="OnRepairServiceClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaRepairGlyph}" Text="Repair" />
                                        </Button>
                                        <Button AutomationProperties.Name="{x:Bind StartAutomationName}"
                                                AutomationProperties.HelpText="Start this managed service."
                                                ToolTipService.ToolTip="Start this service"
                                                Click="OnStartServiceClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaPlayGlyph}" Text="Start" />
                                        </Button>
                                        <Button AutomationProperties.Name="{x:Bind StopAutomationName}"
                                                AutomationProperties.HelpText="Stop this managed service."
                                                ToolTipService.ToolTip="Stop this service"
                                                Click="OnStopServiceClicked">
                                            <controls:IconLabel Glyph="{StaticResource FaStopGlyph}" Text="Stop" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
