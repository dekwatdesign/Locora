<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Locora.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Locora.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Locora.App.Models">
    <ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowSettings" />
                <VisualState x:Name="WideSettings">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsPathColumn2.Width" Value="*" />
                        <Setter Target="RuntimePathPanel.(Grid.Row)" Value="0" />
                        <Setter Target="RuntimePathPanel.(Grid.Column)" Value="1" />
                        <Setter Target="DataPathPanel.(Grid.Row)" Value="1" />
                        <Setter Target="TempPathPanel.(Grid.Row)" Value="1" />
                        <Setter Target="TempPathPanel.(Grid.Column)" Value="1" />
                        <Setter Target="SettingsStateColumn2.Width" Value="*" />
                        <Setter Target="OnboardingStatePath.(Grid.Row)" Value="0" />
                        <Setter Target="OnboardingStatePath.(Grid.Column)" Value="1" />
                        <Setter Target="FirstRunButtons.Orientation" Value="Horizontal" />
                        <Setter Target="RootButtons.Orientation" Value="Horizontal" />
                        <Setter Target="ProjectConfigButtons.Orientation" Value="Horizontal" />
                        <Setter Target="AppUpdateButtons.Orientation" Value="Horizontal" />
                        <Setter Target="PortableDistributionButtons.Orientation" Value="Horizontal" />
                        <Setter Target="PackageManifestButtons.Orientation" Value="Horizontal" />
                        <Setter Target="ToolPackageButtons.Orientation" Value="Horizontal" />
                        <Setter Target="StackProfileButtons.Orientation" Value="Horizontal" />
                        <Setter Target="CustomToolButtons.Orientation" Value="Horizontal" />
                        <Setter Target="PackageDownloadButtons.Orientation" Value="Horizontal" />
                        <Setter Target="RuntimeBackupButtons.Orientation" Value="Horizontal" />
                        <Setter Target="PortableRelocationButtons.Orientation" Value="Horizontal" />
                        <Setter Target="UserEnvironmentButtons.Orientation" Value="Horizontal" />
                        <Setter Target="ExplorerContextButtons.Orientation" Value="Horizontal" />
                        <Setter Target="EditorPreferenceButtons.Orientation" Value="Horizontal" />
                        <Setter Target="DomainDefaultButtons.Orientation" Value="Horizontal" />
                        <Setter Target="PermissionActionButtons.Orientation" Value="Horizontal" />
                        <Setter Target="PermissionEmptyActions.Orientation" Value="Horizontal" />
                        <Setter Target="DiagnosticReportActions.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Advanced settings are grouped by the files and folders they affect. JSON changes are reloaded by the host where supported; generated artifacts usually need refresh or repair actions."
                       TextWrapping="Wrap"
                       Opacity="0.82" />

            <InfoBar IsOpen="True"
                     Severity="Informational"
                     Title="Power-user surface"
                     Message="Use these controls when you need to inspect portable paths, edit JSON config, or recover generated runtime artifacts." />

            <Expander Header="First-run onboarding"
                      IsExpanded="True"
                      AutomationProperties.HelpText="Show or hide the first-run setup guide on the Dashboard.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.FirstRunOnboardingStatusLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Onboarding settings file"
                                 Text="{x:Bind ViewModel.OnboardingSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="FirstRunButtons" Orientation="Vertical" Spacing="8">
                            <Button AccessKey="G"
                                    AutomationProperties.HelpText="Show the first-run setup guide on the Dashboard."
                                    ToolTipService.ToolTip="Show the Dashboard setup guide"
                                    Command="{x:Bind ViewModel.ShowFirstRunOnboardingCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaDashboardGlyph}" Text="Show" />
                            </Button>
                            <Button AccessKey="H"
                                    AutomationProperties.HelpText="Hide the first-run setup guide from the Dashboard."
                                    ToolTipService.ToolTip="Hide the Dashboard setup guide"
                                    Command="{x:Bind ViewModel.DismissFirstRunOnboardingCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaDashboardGlyph}" Text="Hide" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Portable workspace paths"
                      IsExpanded="True"
                      AutomationProperties.HelpText="Open and inspect Locora portable workspace folders.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Open the portable folders Locora uses for apps, runtime binaries, service data, logs, config, and temporary files."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />

                        <TextBox Header="Portable root"
                                 Text="{x:Bind ViewModel.EnvironmentRoot, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="RootButtons" Orientation="Vertical" Spacing="8">
                            <Button AccessKey="P"
                                    AutomationProperties.HelpText="Open the portable root folder in File Explorer."
                                    ToolTipService.ToolTip="Open the portable root folder"
                                    Command="{x:Bind ViewModel.OpenEnvironmentRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Portable" />
                            </Button>
                            <Button AccessKey="C"
                                    AutomationProperties.HelpText="Open the configuration folder in File Explorer."
                                    ToolTipService.ToolTip="Open the configuration folder"
                                    Command="{x:Bind ViewModel.OpenConfigRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Config" />
                            </Button>
                            <Button AccessKey="L"
                                    AutomationProperties.HelpText="Open the logs folder in File Explorer."
                                    ToolTipService.ToolTip="Open the logs folder"
                                    Command="{x:Bind ViewModel.OpenLogsRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Logs" />
                            </Button>
                        </StackPanel>

                        <Grid x:Name="SettingsPathGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="SettingsPathColumn2" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="ProjectsPathPanel" Grid.Row="0" Grid.Column="0" Spacing="8">
                                <TextBox Header="Projects root"
                                         Text="{x:Bind ViewModel.ProjectRoot, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <Button AutomationProperties.HelpText="Open the projects root folder in File Explorer."
                                        ToolTipService.ToolTip="Open the projects root folder"
                                        Command="{x:Bind ViewModel.OpenProjectRootCommand}"
                                        HorizontalAlignment="Left">
                                    <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Projects" />
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="RuntimePathPanel" Grid.Row="1" Grid.Column="0" Spacing="8">
                                <TextBox Header="Runtime binaries"
                                         Text="{x:Bind ViewModel.BinRoot, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <Button AutomationProperties.HelpText="Open the runtime binaries folder in File Explorer."
                                        ToolTipService.ToolTip="Open the runtime binaries folder"
                                        Command="{x:Bind ViewModel.OpenBinRootCommand}"
                                        HorizontalAlignment="Left">
                                    <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Bin" />
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="DataPathPanel" Grid.Row="2" Grid.Column="0" Spacing="8">
                                <TextBox Header="Service data"
                                         Text="{x:Bind ViewModel.DataRoot, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <Button AutomationProperties.HelpText="Open the service data folder in File Explorer."
                                        ToolTipService.ToolTip="Open the service data folder"
                                        Command="{x:Bind ViewModel.OpenDataRootCommand}"
                                        HorizontalAlignment="Left">
                                    <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Data" />
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="TempPathPanel" Grid.Row="3" Grid.Column="0" Spacing="8">
                                <TextBox Header="Temporary files"
                                         Text="{x:Bind ViewModel.TempRoot, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <Button AutomationProperties.HelpText="Open the temporary files folder in File Explorer."
                                        ToolTipService.ToolTip="Open the temporary files folder"
                                        Command="{x:Bind ViewModel.OpenTempRootCommand}"
                                        HorizontalAlignment="Left">
                                    <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Temp" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="JSON configuration files"
                      AutomationProperties.HelpText="Open Locora JSON configuration files for editing or inspection.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="These files are the source of truth for shell preferences, supervisor behavior, service definitions, project discovery, and package catalog state."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />

                        <TextBox Header="App settings"
                                 Text="{x:Bind ViewModel.AppSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <Button AutomationProperties.HelpText="Open the app settings JSON file."
                                ToolTipService.ToolTip="Open appsettings.json"
                                Command="{x:Bind ViewModel.OpenAppSettingsFileCommand}"
                                HorizontalAlignment="Left">
                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="appsettings.json" />
                        </Button>

                        <TextBox Header="Supervisor settings"
                                 Text="{x:Bind ViewModel.SupervisorSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <Button AutomationProperties.HelpText="Open the supervisor settings JSON file."
                                ToolTipService.ToolTip="Open supervisor.json"
                                Command="{x:Bind ViewModel.OpenSupervisorSettingsFileCommand}"
                                HorizontalAlignment="Left">
                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="supervisor.json" />
                        </Button>

                        <TextBox Header="Services settings"
                                 Text="{x:Bind ViewModel.ServicesSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <Button AutomationProperties.HelpText="Open the services settings JSON file."
                                ToolTipService.ToolTip="Open services.json"
                                Command="{x:Bind ViewModel.OpenServicesSettingsFileCommand}"
                                HorizontalAlignment="Left">
                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="services.json" />
                        </Button>

                        <TextBox Header="Project discovery settings"
                                 Text="{x:Bind ViewModel.ProjectsSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="ProjectConfigButtons" Orientation="Vertical" Spacing="8">
                            <Button AutomationProperties.HelpText="Open the project discovery settings JSON file."
                                    ToolTipService.ToolTip="Open projects.json"
                                    Command="{x:Bind ViewModel.OpenProjectsSettingsFileCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="projects.json" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the folder containing Locora configuration files."
                                    ToolTipService.ToolTip="Open the configuration folder"
                                    Command="{x:Bind ViewModel.OpenConfigRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Config" />
                            </Button>
                        </StackPanel>

                        <TextBox Header="Configuration backups"
                                 Text="{x:Bind ViewModel.ConfigBackupRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBlock Text="{x:Bind ViewModel.ConfigBackupStatus, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Latest backup archive"
                                 Text="{x:Bind ViewModel.LatestConfigBackupPath, Mode=OneWay}"
                                 PlaceholderText="No backup created in this app session"
                                 IsReadOnly="True" />
                        <TextBox Header="Restore backup archive"
                                 Text="{x:Bind ViewModel.ConfigRestorePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="locora-config-YYYYMMDD-HHMMSS.zip" />
                        <TextBlock Text="{x:Bind ViewModel.ConfigRestoreStatus, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <StackPanel x:Name="ConfigBackupButtons" Orientation="Vertical" Spacing="8">
                            <Button AutomationProperties.HelpText="Create a timestamped zip archive of usr/config."
                                    ToolTipService.ToolTip="Back up Locora configuration"
                                    Command="{x:Bind ViewModel.BackupConfigCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaBackupGlyph}" Text="Back Up" />
                            </Button>
                            <Button AutomationProperties.HelpText="Restore a Locora configuration backup archive into usr/config."
                                    ToolTipService.ToolTip="Restore configuration backup"
                                    Command="{x:Bind ViewModel.RestoreConfigCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaBackupGlyph}" Text="Restore" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the folder containing configuration backup archives."
                                    ToolTipService.ToolTip="Open configuration backups"
                                    Command="{x:Bind ViewModel.OpenConfigBackupRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaBackupGlyph}" Text="Backups" />
                            </Button>
                        </StackPanel>

                        <TextBox Header="Stack profiles"
                                 Text="{x:Bind ViewModel.ProfilesSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <Button AutomationProperties.HelpText="Open the stack profiles JSON file."
                                ToolTipService.ToolTip="Open profiles.json"
                                Command="{x:Bind ViewModel.OpenProfilesSettingsFileCommand}"
                                HorizontalAlignment="Left">
                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="profiles.json" />
                        </Button>

                        <TextBox Header="Package sources"
                                 Text="{x:Bind ViewModel.PackageSourcesSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <Button AutomationProperties.HelpText="Open the package sources JSON file."
                                ToolTipService.ToolTip="Open sources.json"
                                Command="{x:Bind ViewModel.OpenPackageSourcesSettingsFileCommand}"
                                HorizontalAlignment="Left">
                            <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="sources.json" />
                        </Button>

                        <TextBox Header="Package lock state"
                                 Text="{x:Bind ViewModel.PackagesLockSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Bundled package manifests"
                                 Text="{x:Bind ViewModel.PackageManifestsRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="PackageManifestButtons" Orientation="Vertical" Spacing="8">
                            <Button AutomationProperties.HelpText="Open the package lock JSON file."
                                    ToolTipService.ToolTip="Open packages.lock.json"
                                    Command="{x:Bind ViewModel.OpenPackagesLockSettingsFileCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaPackageGlyph}" Text="packages.lock.json" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the bundled package manifests folder."
                                    ToolTipService.ToolTip="Open the package manifests folder"
                                    Command="{x:Bind ViewModel.OpenPackageManifestsRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaPackageGlyph}" Text="package-manifests" />
                            </Button>
                        </StackPanel>

                        <Grid x:Name="SettingsStateGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="SettingsStateColumn2" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="PinnedProjectsStatePath"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     Header="Pinned projects state"
                                     Text="{x:Bind ViewModel.ProjectPinsSettingsFilePath, Mode=OneWay}"
                                     IsReadOnly="True" />
                            <TextBox x:Name="OnboardingStatePath"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     Header="Onboarding state"
                                     Text="{x:Bind ViewModel.OnboardingSettingsFilePath, Mode=OneWay}"
                                     IsReadOnly="True" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Application updates"
                      AutomationProperties.HelpText="Check a configured release manifest, inspect cached update plan files, and open manual release links.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.AppUpdateSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.AppUpdateDetails, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.AppUpdateCheckPolicy, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="State"
                                 Text="{x:Bind ViewModel.AppUpdateState, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Current version"
                                 Text="{x:Bind ViewModel.AppUpdateCurrentVersion, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Developer"
                                 Text="{x:Bind ViewModel.DeveloperName, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Latest version"
                                 Text="{x:Bind ViewModel.AppUpdateLatestVersion, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Channel"
                                 Text="{x:Bind ViewModel.AppUpdateChannel, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Last checked"
                                 Text="{x:Bind ViewModel.AppUpdateCheckedAtLabel, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Manifest URI"
                                 Text="{x:Bind ViewModel.AppUpdateManifestUri, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Release page"
                                 Text="{x:Bind ViewModel.AppUpdateReleasePageUri, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Download URI"
                                 Text="{x:Bind ViewModel.AppUpdateDownloadUri, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="SHA-256"
                                 Text="{x:Bind ViewModel.AppUpdateSha256, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Update plan"
                                 Text="{x:Bind ViewModel.AppUpdatePlanPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Cached manifest"
                                 Text="{x:Bind ViewModel.AppUpdateManifestCachePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Example manifest"
                                 Text="{x:Bind ViewModel.AppUpdateManifestExamplePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Download folder"
                                 Text="{x:Bind ViewModel.AppUpdateDownloadRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="AppUpdateButtons" Orientation="Vertical" Spacing="8">
                            <Button AutomationProperties.HelpText="Read the configured app update manifest and refresh the cached update plan."
                                    ToolTipService.ToolTip="Check configured update manifest"
                                    Command="{x:Bind ViewModel.CheckForAppUpdatesCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Check" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the release page URI from the app update status."
                                    ToolTipService.ToolTip="Open app update release page"
                                    Command="{x:Bind ViewModel.OpenAppUpdateReleasePageCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaGlobeGlyph}" Text="Release" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the update download URI from the app update status."
                                    ToolTipService.ToolTip="Open app update download"
                                    Command="{x:Bind ViewModel.OpenAppUpdateDownloadCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaDownloadGlyph}" Text="Download" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the cached update plan JSON file."
                                    ToolTipService.ToolTip="Open update plan"
                                    Command="{x:Bind ViewModel.OpenAppUpdatePlanCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Plan" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the cached release manifest JSON file."
                                    ToolTipService.ToolTip="Open cached update manifest"
                                    Command="{x:Bind ViewModel.OpenAppUpdateManifestCacheCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Cache" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the example release manifest schema."
                                    ToolTipService.ToolTip="Open example update manifest"
                                    Command="{x:Bind ViewModel.OpenAppUpdateManifestExampleCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Example" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open appsettings.json to edit the Updates section."
                                    ToolTipService.ToolTip="Open appsettings.json"
                                    Command="{x:Bind ViewModel.OpenAppSettingsFileCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="appsettings.json" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Portable distribution automation"
                      AutomationProperties.HelpText="Generate and inspect portable ZIP packaging scripts, release plans, and update manifest templates.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.PortableDistributionStatus, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.PortableDistributionModeLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.PortableDistributionScopeLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Distribution folder"
                                 Text="{x:Bind ViewModel.PortableDistributionRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Artifacts folder"
                                 Text="{x:Bind ViewModel.PortableDistributionArtifactsRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Build script"
                                 Text="{x:Bind ViewModel.PortableDistributionScriptPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Distribution plan"
                                 Text="{x:Bind ViewModel.PortableDistributionPlanPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="README"
                                 Text="{x:Bind ViewModel.PortableDistributionReadmePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Release manifest template"
                                 Text="{x:Bind ViewModel.PortableDistributionManifestTemplatePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="PortableDistributionButtons" Orientation="Vertical" Spacing="8">
                            <Button AutomationProperties.HelpText="Regenerate the portable distribution PowerShell script, plan, README, and release manifest template."
                                    ToolTipService.ToolTip="Regenerate portable distribution files"
                                    Command="{x:Bind ViewModel.RefreshPortableDistributionFilesCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaRefreshGlyph}" Text="Refresh" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the generated PowerShell script for building a portable ZIP release."
                                    ToolTipService.ToolTip="Open portable distribution script"
                                    Command="{x:Bind ViewModel.OpenPortableDistributionScriptCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Script" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the generated portable distribution plan JSON file."
                                    ToolTipService.ToolTip="Open portable distribution plan"
                                    Command="{x:Bind ViewModel.OpenPortableDistributionPlanCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Plan" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the generated portable distribution README."
                                    ToolTipService.ToolTip="Open portable distribution README"
                                    Command="{x:Bind ViewModel.OpenPortableDistributionReadmeCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="README" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the generated release manifest template for update checks."
                                    ToolTipService.ToolTip="Open release manifest template"
                                    Command="{x:Bind ViewModel.OpenPortableDistributionManifestTemplateCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFileCodeGlyph}" Text="Template" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the folder containing generated portable distribution helper files."
                                    ToolTipService.ToolTip="Open portable distribution folder"
                                    Command="{x:Bind ViewModel.OpenPortableDistributionRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Distribution" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the folder where portable ZIP artifacts should be written."
                                    ToolTipService.ToolTip="Open portable distribution artifacts"
                                    Command="{x:Bind ViewModel.OpenPortableDistributionArtifactsRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Artifacts" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Project discovery and domain defaults"
                      AutomationProperties.HelpText="Edit generated domain defaults and run repair actions for hosts and vhost artifacts.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Edit generated project URL defaults from here, then regenerate hosts previews and vhosts so disk artifacts match the new settings."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Domain suffix"
                                 Text="{x:Bind ViewModel.GeneratedDomainSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="test or dev.local" />
                        <ComboBox Header="Default scheme"
                                  ItemsSource="{x:Bind ViewModel.DomainSchemes, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.GeneratedDomainScheme, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DomainSettingsPreview, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DomainSettingsStatus, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <StackPanel x:Name="DomainDefaultButtons" Orientation="Vertical" Spacing="8">
                            <Button AccessKey="S"
                                    AutomationProperties.HelpText="Save the generated domain suffix and default scheme."
                                    ToolTipService.ToolTip="Save generated domain defaults"
                                    Command="{x:Bind ViewModel.SaveDomainSettingsCommand}">
