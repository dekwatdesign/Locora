                                    Command="{x:Bind ViewModel.CopyDiagnosticReportCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaCopyGlyph}" Text="Copy" />
                            </Button>
                            <Button AccessKey="E"
                                    AutomationProperties.HelpText="Export the diagnostic report as a Markdown file."
                                    ToolTipService.ToolTip="Export diagnostic report as Markdown"
                                    Command="{x:Bind ViewModel.ExportDiagnosticReportCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaExportGlyph}" Text="Export" />
                            </Button>
                            <Button AutomationProperties.HelpText="Open the logs folder that contains exported diagnostic reports."
                                    ToolTipService.ToolTip="Open logs folder"
                                    Command="{x:Bind ViewModel.OpenLogsRootCommand}">
                                <controls:IconLabel Glyph="{StaticResource FaFolderOpenGlyph}" Text="Logs" />
                            </Button>
                        </StackPanel>
                        <TextBox Header="Last exported report"
                                 Text="{x:Bind ViewModel.DiagnosticReportPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
