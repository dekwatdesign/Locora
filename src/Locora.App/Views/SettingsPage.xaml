                                            AutomationProperties.HelpText="Open the package lock JSON file."
                                            ToolTipService.ToolTip="Open packages.lock.json"
                                            Command="{x:Bind ViewModel.OpenPackagesLockSettingsFileCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl Visibility="{x:Bind ViewModel.HasPackageDownloads, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ItemsSource="{x:Bind ViewModel.PackageDownloads, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PackageDownloadCard">
                                    <Border Style="{StaticResource SettingsInnerCardBorderStyle}" Margin="0,0,0,8">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{x:Bind StateLabel}" />
                                            <TextBlock Text="{x:Bind ChecksumLabel}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ExtractionLabel}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind VersionLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind SourceLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind ArtifactLabel}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBox Header="Cache path"
                                                     Text="{x:Bind CachePath}"
                                                     IsReadOnly="True" />
                                            <TextBox Header="Install path"
                                                     Text="{x:Bind InstallPath}"
                                                     IsReadOnly="True" />
                                            <TextBox Header="Active path"
                                                     Text="{x:Bind ActivePath}"
                                                     IsReadOnly="True" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Remove Installed Versions"
                                                        AutomationProperties.Name="{x:Bind RemoveAutomationName}"
                                                        AutomationProperties.HelpText="Remove installed runtime folders for this package without deleting cached artifacts."
                                                        ToolTipService.ToolTip="Remove installed runtime folders for this package"
                                                        IsEnabled="{x:Bind CanRemoveInstall, Mode=OneWay}"
                                                        Command="{x:Bind RemoveInstallCommand}"
                                                        CommandParameter="{x:Bind}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Runtime backup guidance"
                      AutomationProperties.HelpText="Review the runtime, package, and service-data paths that matter for portable backup and restore planning.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.RuntimeBackupStatusLabel, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.RuntimeBackupIncludeLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.RuntimeBackupRestoreOrderLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.RuntimeBackupSkipLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />

                        <TextBox Header="Service data"
                                 Text="{x:Bind ViewModel.DataRoot, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Runtime binaries"
                                 Text="{x:Bind ViewModel.BinRoot, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Package cache"
                                 Text="{x:Bind ViewModel.PackageCacheRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Package lock state"
                                 Text="{x:Bind ViewModel.PackagesLockSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />

                        <StackPanel x:Name="RuntimeBackupButtons" Orientation="Vertical" Spacing="8">
                            <Button Content="Back Up Config"
                                    AutomationProperties.HelpText="Create a timestamped zip archive of usr/config before backing up runtime folders."
                                    ToolTipService.ToolTip="Back up Locora configuration"
                                    Command="{x:Bind ViewModel.BackupConfigCommand}" />
                            <Button Content="Open Data"
                                    AutomationProperties.HelpText="Open the service data folder in File Explorer."
                                    ToolTipService.ToolTip="Open service data"
                                    Command="{x:Bind ViewModel.OpenDataRootCommand}" />
                            <Button Content="Open Bin"
                                    AutomationProperties.HelpText="Open the runtime binaries folder in File Explorer."
                                    ToolTipService.ToolTip="Open runtime binaries"
                                    Command="{x:Bind ViewModel.OpenBinRootCommand}" />
                            <Button Content="Open Package Cache"
                                    AutomationProperties.HelpText="Open the package cache folder in File Explorer."
                                    ToolTipService.ToolTip="Open package cache"
                                    Command="{x:Bind ViewModel.OpenPackageCacheRootCommand}" />
                            <Button Content="Open packages.lock.json"
                                    AutomationProperties.HelpText="Open the package lock JSON file."
                                    ToolTipService.ToolTip="Open packages.lock.json"
                                    Command="{x:Bind ViewModel.OpenPackagesLockSettingsFileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Portable relocation validation"
                      AutomationProperties.HelpText="Validate whether service, project, package, runtime, and tool paths can survive moving Locora to another folder or drive.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.PortableRelocationValidationStatusLabel, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PortableRelocationValidationDetails, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Portable root"
                                 Text="{x:Bind ViewModel.EnvironmentRoot, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Projects root"
                                 Text="{x:Bind ViewModel.ProjectRoot, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Configuration root"
                                 Text="{x:Bind ViewModel.ConfigRoot, Mode=OneWay}"
                                 IsReadOnly="True" />

                        <StackPanel x:Name="PortableRelocationButtons" Orientation="Vertical" Spacing="8">
                            <Button Content="Refresh Snapshot"
                                    AutomationProperties.HelpText="Run the portable relocation readiness check through the supervisor snapshot."
                                    ToolTipService.ToolTip="Validate portable relocation readiness"
                                    Command="{x:Bind ViewModel.RefreshCommand}" />
                            <Button Content="Export Diagnostic Report"
                                    AutomationProperties.HelpText="Export diagnostics including portable relocation validation details."
                                    ToolTipService.ToolTip="Export diagnostic report"
                                    Command="{x:Bind ViewModel.ExportDiagnosticReportCommand}" />
                            <Button Content="Open Config Folder"
                                    AutomationProperties.HelpText="Open the configuration folder containing service, package, and project path settings."
                                    ToolTipService.ToolTip="Open configuration folder"
                                    Command="{x:Bind ViewModel.OpenConfigRootCommand}" />
                            <Button Content="Open Projects Root"
                                    AutomationProperties.HelpText="Open the portable projects root."
                                    ToolTipService.ToolTip="Open projects root"
                                    Command="{x:Bind ViewModel.OpenProjectRootCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="PATH and environment variables"
                      AutomationProperties.HelpText="Review generated PowerShell scripts for user-level PATH and LOCORA variable changes.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.UserEnvironmentStatus, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.UserEnvironmentManagedPathEntriesLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.UserEnvironmentManagedVariablesLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Install script"
                                 Text="{x:Bind ViewModel.UserEnvironmentApplyScriptPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Uninstall script"
                                 Text="{x:Bind ViewModel.UserEnvironmentRemoveScriptPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Manifest"
                                 Text="{x:Bind ViewModel.UserEnvironmentManifestPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Backup folder"
                                 Text="{x:Bind ViewModel.UserEnvironmentBackupRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="UserEnvironmentButtons" Orientation="Vertical" Spacing="8">
                            <Button Content="Refresh Environment Scripts"
                                    AutomationProperties.HelpText="Regenerate the CurrentUser PowerShell scripts and manifest for this portable root."
                                    ToolTipService.ToolTip="Regenerate user environment scripts"
                                    Command="{x:Bind ViewModel.RefreshUserEnvironmentFilesCommand}" />
                            <Button Content="Open Install Script"
                                    AutomationProperties.HelpText="Open the generated PowerShell script that adds Locora user PATH and LOCORA variables."
                                    ToolTipService.ToolTip="Open the generated environment install script"
                                    Command="{x:Bind ViewModel.OpenUserEnvironmentApplyScriptCommand}" />
                            <Button Content="Open Uninstall Script"
                                    AutomationProperties.HelpText="Open the generated PowerShell script that removes Locora user PATH and LOCORA variables."
                                    ToolTipService.ToolTip="Open the generated environment uninstall script"
                                    Command="{x:Bind ViewModel.OpenUserEnvironmentRemoveScriptCommand}" />
                            <Button Content="Open Manifest"
                                    AutomationProperties.HelpText="Open the JSON manifest describing the generated PATH and environment variable plan."
                                    ToolTipService.ToolTip="Open the generated environment manifest"
                                    Command="{x:Bind ViewModel.OpenUserEnvironmentManifestCommand}" />
                            <Button Content="Open Aliases Folder"
                                    AutomationProperties.HelpText="Open the aliases folder that persistent PATH scripts add for the current user."
                                    ToolTipService.ToolTip="Open the aliases folder"
                                    Command="{x:Bind ViewModel.OpenAliasesRootCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Explorer and context menus"
                      AutomationProperties.HelpText="Review in-app Explorer actions and project card context menu behavior.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.ExplorerContextIntegrationSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.ShellContextMenuRegistrationSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Projects root"
                                 Text="{x:Bind ViewModel.ProjectRoot, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Shell integration folder"
                                 Text="{x:Bind ViewModel.ShellIntegrationRootPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Install registry file"
                                 Text="{x:Bind ViewModel.ShellContextMenuInstallFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Uninstall registry file"
                                 Text="{x:Bind ViewModel.ShellContextMenuUninstallFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Registered executable"
                                 Text="{x:Bind ViewModel.ShellContextMenuExecutablePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="ExplorerContextButtons" Orientation="Vertical" Spacing="8">
                            <Button Content="Refresh Registry Files"
                                    AutomationProperties.HelpText="Regenerate the install and uninstall registry files for the current Locora executable path."
                                    ToolTipService.ToolTip="Regenerate shell context menu registry files"
                                    Command="{x:Bind ViewModel.RefreshShellContextMenuFilesCommand}" />
                            <Button Content="Open Install .reg"
                                    AutomationProperties.HelpText="Open the generated registry file that adds Locora context menus for the current Windows user."
                                    ToolTipService.ToolTip="Open the generated install registry file"
                                    Command="{x:Bind ViewModel.OpenShellContextMenuInstallFileCommand}" />
                            <Button Content="Open Uninstall .reg"
                                    AutomationProperties.HelpText="Open the generated registry file that removes Locora context menus for the current Windows user."
                                    ToolTipService.ToolTip="Open the generated uninstall registry file"
                                    Command="{x:Bind ViewModel.OpenShellContextMenuUninstallFileCommand}" />
                            <Button Content="Open Shell Integration Folder"
                                    AutomationProperties.HelpText="Open the folder containing generated shell integration files."
                                    ToolTipService.ToolTip="Open shell integration folder"
                                    Command="{x:Bind ViewModel.OpenShellIntegrationRootCommand}" />
                            <Button Content="Open Projects Root"
                                    AutomationProperties.HelpText="Open the projects root folder in File Explorer."
                                    ToolTipService.ToolTip="Open the projects root folder"
                                    Command="{x:Bind ViewModel.OpenProjectRootCommand}" />
                            <Button Content="Open Portable Root"
                                    AutomationProperties.HelpText="Open the portable root folder in File Explorer."
                                    ToolTipService.ToolTip="Open the portable root folder"
                                    Command="{x:Bind ViewModel.OpenEnvironmentRootCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Editor integration"
                      AutomationProperties.HelpText="Review preferred editor integration and test project-aware editor launches.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.EditorIntegrationSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBox Header="Preferred editor"
                                 Text="{x:Bind ViewModel.PreferredEditorLabel, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="App settings"
                                 Text="{x:Bind ViewModel.AppSettingsFilePath, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="EditorPreferenceButtons" Orientation="Vertical" Spacing="8">
                            <Button Content="Open Portable Root in Editor"
                                    AutomationProperties.HelpText="Open the portable root with the preferred editor integration."
                                    ToolTipService.ToolTip="Open portable root in editor"
                                    Command="{x:Bind ViewModel.OpenEnvironmentRootInEditorCommand}" />
                            <Button Content="Open Projects Root in Editor"
                                    AutomationProperties.HelpText="Open the projects root with the preferred editor integration."
                                    ToolTipService.ToolTip="Open projects root in editor"
                                    Command="{x:Bind ViewModel.OpenProjectRootInEditorCommand}" />
                            <Button Content="Open appsettings.json"
                                    AutomationProperties.HelpText="Open the app settings JSON file to change the preferred editor command."
                                    ToolTipService.ToolTip="Open appsettings.json"
                                    Command="{x:Bind ViewModel.OpenAppSettingsFileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Shell preferences and tray"
                      AutomationProperties.HelpText="Review shell preferences and tray behavior.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Closing Locora hides the shell to the Windows notification area. Use the tray icon to reopen the shell, jump to diagnostics, refresh status, start all services, stop all services, or exit cleanly."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                        <TextBox Header="Preferred toolchain"
                                 Text="{x:Bind ViewModel.PreferredToolchainSummary, Mode=OneWay}"
                                 IsReadOnly="True" />
                        <TextBox Header="Supervisor pipe"
                                 Text="{x:Bind ViewModel.PipeName, Mode=OneWay}"
                                 IsReadOnly="True" />
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Permission and elevation diagnostics"
                      IsExpanded="True"
                      AutomationProperties.HelpText="Review permission diagnostics and restart the supervisor with administrator rights when needed.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.PermissionDiagnosticsSummary, Mode=OneWay}" />
                        <TextBlock Text="Locora checks whether the current supervisor can write to its portable workspace, update hosts targets safely, relaunch through UAC, and manage CurrentUser SSL trust."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <StackPanel x:Name="PermissionActionButtons" Orientation="Vertical" Spacing="8">
                            <Button Content="Restart Supervisor as Admin"
                                    AccessKey="A"
                                    AutomationProperties.HelpText="Ask Windows to restart Locora Supervisor with administrator rights."
                                    ToolTipService.ToolTip="Restart supervisor as administrator"
                                    Command="{x:Bind ViewModel.RestartSupervisorElevatedCommand}" />
                            <Button Content="Refresh Snapshot"
                                    AutomationProperties.HelpText="Refresh permission diagnostics from the supervisor."
                                    ToolTipService.ToolTip="Refresh permission diagnostics"
                                    Command="{x:Bind ViewModel.RefreshCommand}" />
                        </StackPanel>

                        <Border Visibility="{x:Bind ViewModel.ShowPermissionDiagnosticsEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SettingsInnerCardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="No permission diagnostics yet" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="Refresh to load supervisor permission checks, then restart elevated only when protected Windows paths need writes."
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                                <StackPanel x:Name="PermissionEmptyActions" Orientation="Vertical" Spacing="8">
                                    <Button Content="Refresh Snapshot"
                                            AutomationProperties.HelpText="Refresh permission diagnostics from the supervisor."
                                            ToolTipService.ToolTip="Refresh permission diagnostics"
                                            Command="{x:Bind ViewModel.RefreshCommand}" />
                                    <Button Content="Open Portable Root"
                                            AutomationProperties.HelpText="Open the portable root folder in File Explorer."
                                            ToolTipService.ToolTip="Open the portable root folder"
                                            Command="{x:Bind ViewModel.OpenEnvironmentRootCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.PermissionDiagnostics, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PermissionDiagnosticCard">
                                    <Border Style="{StaticResource SettingsInnerCardBorderStyle}" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{x:Bind StateLabel}" />
                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" Opacity="0.72" />
                                            <TextBlock Text="{x:Bind SuggestedAction}" TextWrapping="Wrap" Opacity="0.72" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Diagnostic report"
                      AutomationProperties.HelpText="Copy or export a Markdown diagnostic report for troubleshooting.">
                <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Copy or export a Markdown snapshot with services, health issues, validation results, portable relocation checks, port diagnostics, permissions, package sources, package downloads, runtime versions, runtime backup guidance, stack profiles, custom tools, SSL certificate diagnostics, projects, and key paths."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <StackPanel x:Name="DiagnosticReportActions" Orientation="Vertical" Spacing="8">
                            <Button Content="Copy Diagnostic Report"
                                    AccessKey="Y"
                                    AutomationProperties.HelpText="Copy the diagnostic report to the clipboard."
                                    ToolTipService.ToolTip="Copy diagnostic report to clipboard"
                                    Command="{x:Bind ViewModel.CopyDiagnosticReportCommand}" />
                            <Button Content="Export Markdown Report"
                                    AccessKey="E"
                                    AutomationProperties.HelpText="Export the diagnostic report as a Markdown file."
                                    ToolTipService.ToolTip="Export diagnostic report as Markdown"
                                    Command="{x:Bind ViewModel.ExportDiagnosticReportCommand}" />
                            <Button Content="Open Logs"
                                    AutomationProperties.HelpText="Open the logs folder that contains exported diagnostic reports."
                                    ToolTipService.ToolTip="Open logs folder"
                                    Command="{x:Bind ViewModel.OpenLogsRootCommand}" />
                        </StackPanel>
                        <TextBox Header="Last exported report"
                                 Text="{x:Bind ViewModel.DiagnosticReportPath, Mode=OneWay}"
                                 IsReadOnly="True" />
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
